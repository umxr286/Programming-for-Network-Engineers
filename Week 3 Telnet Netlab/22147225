# import required modules/packages/library
import pexpect
from pexpect.exceptions import TIMEOUT 
# define variables
ip_address = '192.168.56.101'
username = 'cisco'
password = 'cisco123!'

# create telnet session
session = pexpect.spawn('telnet ' + ip_address, encoding='utf-8 , 
result = session.expect('username:', pexpect.TIMEOUT)
# check for error, if exists then display error and exit if result !=0:
   print('--- FAILURE! creating session for: ', ip_address)
   exit()
# session is expecting username, enter details
session.sendline(username)
result = session.expect(['password:', pexpect.TIMEOUT])

#check for error, if exists then display error and exit
if result != 0:
    print('--- FAILURE! entering username: ', username)
    exit()

# session is expecting password, enter details session.sendline(password)
result = session.expect(['#', pexpect.TIMEOUT])

# check for error, if exists then display error and exit 
if result != 0:
    print('--- FAILURE! entering password: ', password)
    exit()

# display a success message if it works
print('-------------------------------------------')
print('')
print('--- success! connecting to: ', ip_address)
print('---               username: ', username)
print('---               password: ', password)
print('')
print('-------------------------------------------')
